{
  "name": "catalog-builder",
  "version": "0.1.0",
  "description": "HTML and CSS catalog builder for static web output, lightweight PDFs and print-oriented PDFs.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "keywords": [
    "catalog",
    "pdf",
    "print",
    "html",
    "css",
    "vivliostyle",
    "nunjucks",
    "typescript"
  ],
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "postinstall": "node install-print-tools.mjs",
    "setup:print": "node install-print-tools.mjs",
    "build": "tsx src/index.ts all",
    "build:web": "tsx src/index.ts web",
    "build:pdf": "tsx src/index.ts pdf",
    "build:print": "tsx src/index.ts print",
    "dev": "tsx src/api/devApi.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@vivliostyle/cli": "^11.3.3",
    "csv-parse": "^5.6.0",
    "fs-extra": "^11.3.0",
    "markdown-it": "^14.1.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.1",
    "@types/nunjucks": "^3.2.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.3"
  }
}
